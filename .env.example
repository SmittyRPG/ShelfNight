# Copy this file to ".env" and fill in the two values from
# Supabase dashboard → Project Settings → API.
# These are safe to ship in the app (they are public keys protected by row-level security).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Only needed for the Wikidata game import script (npm run import:wikidata).
# This is the "service_role" secret key. It is NOT built into the app because it doesn't start with EXPO_PUBLIC_.
# Never share it or commit it.
SUPABASE_SERVICE_ROLE_KEY=
